# Supabase Configuration
# Configure these in Settings > Secrets (or in your local .env file)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Authentication Requirement (default "false")
# Set to "false" to bypass login and use single owner mode
# Set to "true" to require email/password login with per-user ownership
AUTH_REQUIRED="false"

# Port (default 3000)
PORT=3000
